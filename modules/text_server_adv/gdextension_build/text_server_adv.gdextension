[configuration]

entry_symbol = "textserver_advanced_init"
compatibility_minimum = 4.1

[libraries]

macos.debug = "bin/libtextserver_advanced.macos.template_debug.framework"
macos.release = "bin/libtextserver_advanced.macos.template_release.framework"

windows.debug.x86_64 = "bin/libtextserver_advanced.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "bin/libtextserver_advanced.windows.template_release.x86_64.dll"
windows.debug.x86_32 = "bin/libtextserver_advanced.windows.template_debug.x86_32.dll"
windows.release.x86_32 = "bin/libtextserver_advanced.windows.template_release.x86_32.dll"
windows.debug.arm64 = "bin/libtextserver_advanced.windows.template_debug.arm64.dll"
windows.release.arm64 = "bin/libtextserver_advanced.windows.template_release.arm64.dll"

linux.debug.x86_64 = "bin/libtextserver_advanced.linux.template_debug.x86_64.so"
linux.release.x86_64 = "bin/libtextserver_advanced.linux.template_release.x86_64.so"
linux.debug.arm64 = "bin/libtextserver_advanced.linux.template_debug.arm64.so"
linux.release.arm64 = "bin/libtextserver_advanced.linux.template_release.arm64.so"
linux.debug.arm32 = "bin/libtextserver_advanced.linux.template_debug.arm32.so"
linux.release.arm32 = "bin/libtextserver_advanced.linux.template_release.arm32.so"
linux.debug.rv64 = "bin/libtextserver_advanced.linux.template_debug.rv64.so"
linux.release.rv64 = "bin/libtextserver_advanced.linux.template_release.rv64.so"
linux.debug.loongarch64 = "bin/libtextserver_advanced.linux.template_debug.loongarch64.so"
linux.release.loongarch64 = "bin/libtextserver_advanced.linux.template_release.loongarch64.so"
linux.release.alpha = "bin/libtextserver_advanced.linux.template_release.alpha.so"
linux.debug.alpha = "bin/libtextserver_advanced.linux.template_debug.alpha.so"
linux.release.mips64 = "bin/libtextserver_advanced.linux.template_release.mips64.so"
linux.debug.mips64 = "bin/libtextserver_advanced.linux.template_debug.mips64.so"
linux.release.sparc64 = "bin/libtextserver_advanced.linux.template_release.sparc64.so"
linux.debug.sparc64 = "bin/libtextserver_advanced.linux.template_debug.sparc64.so"
linux.release.ppc64 = "bin/libtextserver_advanced.linux.template_release.ppc64.so"
