[configuration]

entry_symbol = "textserver_advanced_init"
compatibility_minimum = 4.1

[libraries]

macos.debug = "bin/libtextserver_advanced.macos.debug.framework"
macos.release = "bin/libtextserver_advanced.macos.release.framework"

windows.debug.x86_64 = "bin/libtextserver_advanced.windows.debug.x86_64.dll"
windows.release.x86_64 = "bin/libtextserver_advanced.windows.release.x86_64.dll"
windows.debug.x86_32 = "bin/libtextserver_advanced.windows.debug.x86_32.dll"
windows.release.x86_32 = "bin/libtextserver_advanced.windows.release.x86_32.dll"
windows.debug.arm64 = "bin/libtextserver_advanced.windows.debug.arm64.dll"
windows.release.arm64 = "bin/libtextserver_advanced.windows.release.arm64.dll"

linux.debug.x86_64 = "bin/libtextserver_advanced.linux.debug.x86_64.so"
linux.release.x86_64 = "bin/libtextserver_advanced.linux.release.x86_64.so"
linux.debug.arm64 = "bin/libtextserver_advanced.linux.debug.arm64.so"
linux.release.arm64 = "bin/libtextserver_advanced.linux.release.arm64.so"
linux.debug.arm32 = "bin/libtextserver_advanced.linux.debug.arm32.so"
linux.release.arm32 = "bin/libtextserver_advanced.linux.release.arm32.so"
linux.debug.rv64 = "bin/libtextserver_advanced.linux.debug.rv64.so"
linux.release.rv64 = "bin/libtextserver_advanced.linux.release.rv64.so"
linux.debug.loongarch64 = "bin/libtextserver_advanced.linux.debug.loongarch64.so"
linux.release.loongarch64 = "bin/libtextserver_advanced.linux.release.loongarch64.so"
linux.release.alpha = "bin/libtextserver_advanced.linux.release.alpha.so"
linux.debug.alpha = "bin/libtextserver_advanced.linux.debug.alpha.so"
linux.release.mips64 = "bin/libtextserver_advanced.linux.release.mips64.so"
linux.debug.mips64 = "bin/libtextserver_advanced.linux.debug.mips64.so"
linux.release.sparc64 = "bin/libtextserver_advanced.linux.release.sparc64.so"
linux.debug.sparc64 = "bin/libtextserver_advanced.linux.debug.sparc64.so"
linux.release.ppc64 = "bin/libtextserver_advanced.linux.release.ppc64.so"
linux.debug.ppc64 = "bin/libtextserver_advanced.linux.debug.ppc64.so"
linux.release.ppc32 = "bin/libtextserver_advanced.linux.release.ppc32.so"
linux.debug.ppc32 = "bin/libtextserver_advanced.linux.debug.ppc32.so"
linux.release.hppa = "bin/libtextserver_advanced.linux.release.hppa.so"
linux.debug.hppa = "bin/libtextserver_advanced.linux.debug.hppa.so"
linux.release.arc32 = "bin/libtextserver_advanced.linux.release.arc32.so"
linux.debug.arc32 = "bin/libtextserver_advanced.linux.debug.arc32.so"
linux.release.arc64 = "bin/libtextserver_advanced.linux.release.arc64.so"
linux.debug.arc64 = "bin/libtextserver_advanced.linux.debug.arc64.so"

web.debug.wasm32 = "bin/libtextserver_advanced.web.debug.wasm32.wasm"
web.release.wasm32 = "bin/libtextserver_advanced.web.release.wasm32.wasm"
web.debug.wasm64 = "bin/libtextserver_advanced.web.debug.wasm64.wasm"
web.release.wasm64 = "bin/libtextserver_advanced.web.release.wasm64.wasm"

android.debug.arm64 = "bin/libtextserver_advanced.android.debug.arm64.so"
android.release.arm64 = "bin/libtextserver_advanced.android.release.arm64.so"
android.debug.arm32 = "bin/libtextserver_advanced.android.debug.arm32.so"
android.release.arm32 = "bin/libtextserver_advanced.android.release.arm32.so"
android.debug.x86_32 = "bin/libtextserver_advanced.android.debug.x86_32.so"
android.release.x86_32 = "bin/libtextserver_advanced.android.release.x86_32.so"
android.debug.x86_64 = "bin/libtextserver_advanced.android.debug.x86_64.so"
android.release.x86_64 = "bin/libtextserver_advanced.android.release.x86_64.so"

ios.debug = "bin/libtextserver_advanced.ios.debug.universal.dylib"
ios.release = "bin/libtextserver_advanced.ios.release.universal.dylib"