linux.release.hppa = "bin/libtextserver_advanced.linux.template_release.hppa.so"
linux.debug.hppa = "bin/libtextserver_advanced.linux.template_debug.hppa.so"
linux.release.arc32 = "bin/libtextserver_advanced.linux.template_release.arc32.so"
linux.debug.arc32 = "bin/libtextserver_advanced.linux.template_debug.arc32.so"
linux.release.arc64 = "bin/libtextserver_advanced.linux.template_release.arc64.so"
linux.debug.arc64 = "bin/libtextserver_advanced.linux.template_debug.arc64.so"

web.debug.wasm32 = "bin/libtextserver_advanced.web.template_debug.wasm32.wasm"
web.release.wasm32 = "bin/libtextserver_advanced.web.template_release.wasm32.wasm"
web.debug.wasm64 = "bin/libtextserver_advanced.web.template_debug.wasm64.wasm"
web.release.wasm64 = "bin/libtextserver_advanced.web.template_release.wasm64.wasm"

android.debug.arm64 = "bin/libtextserver_advanced.android.template_debug.arm64.so"
android.release.arm64 = "bin/libtextserver_advanced.android.template_release.arm64.so"
android.debug.arm32 = "bin/libtextserver_advanced.android.template_debug.arm32.so"
android.release.arm32 = "bin/libtextserver_advanced.android.template_release.arm32.so"
android.debug.x86_32 = "bin/libtextserver_advanced.android.template_debug.x86_32.so"
