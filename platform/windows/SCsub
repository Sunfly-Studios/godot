#!/usr/bin/env python
from misc.utility.scons_hints import *

Import("env")

import os
from pathlib import Path

import platform_windows_builders

sources = []

common_win = [
    "godot_windows.cpp",
    "os_windows.cpp",
    "display_server_windows.cpp",
    "key_mapping_windows.cpp",
    "tts_windows.cpp",
    "windows_terminal_logger.cpp",
    "windows_utils.cpp",
    "native_menu_windows.cpp",
    "gl_manager_windows_native.cpp",
    "gl_manager_windows_angle.cpp",
    "wgl_detect_version.cpp",
    "rendering_context_driver_vulkan_windows.cpp",
    "drop_target_windows.cpp",
    "win_vista_thunks.c",
]

if env.msvc:
    common_win += ["crash_handler_windows_seh.cpp"]
else:
    common_win += ["crash_handler_windows_signal.cpp"]

common_win_wrap = [
    "console_wrapper_windows.cpp",
]


def arrange_program_clean(prog):
    """
    Given an SCons program, arrange for output files SCons doesn't know about
    to be cleaned when SCons is called with --clean
    """
    extensions_to_clean = [".ilk", ".exp", ".pdb", ".lib"]
    for program in prog:
        executable_stem = Path(program.name).stem
        extra_files_to_clean = [f"#bin/{executable_stem}{extension}" for extension in extensions_to_clean]
        Clean(prog, extra_files_to_clean)


def norm_msys_path(p):
    if p and p.startswith("/") and len(p) > 2 and p[2] == "/":
        p = p[1] + ":" + p[2:]
    return p.replace("\\", "/")


res_file = "godot_res.rc"
res_target = "godot_res" + env["OBJSUFFIX"]
res_obj = env.RES(res_target, res_file)
env.Depends(res_obj, "#core/version_generated.gen.h")

env.add_source_files(sources, common_win)
sources += res_obj

msvc_arch_aliases = {
    "x86_32": "x86",
    "x86_64": "x64",
    "arm32": "arm",
    "arm64": "arm64",
}

prog = env.add_program("#bin/godot", sources, PROGSUFFIX=env["PROGSUFFIX"])
arrange_program_clean(prog)

env.Depends(prog, "godot.manifest")
if env.msvc:
    env.Depends(prog, "godot.natvis")

# Build console wrapper app.
if env["windows_subsystem"] == "gui":
    env_wrap = env.Clone()
    res_wrap_file = "godot_res_wrap.rc"
    res_wrap_target = "godot_res_wrap" + env["OBJSUFFIX"]
    res_wrap_obj = env_wrap.RES(res_wrap_target, res_wrap_file)
    env_wrap.Depends(res_wrap_obj, "#core/version_generated.gen.h")

    if env.msvc:
        env_wrap.Append(LINKFLAGS=["/SUBSYSTEM:CONSOLE"])
        env_wrap.Append(LINKFLAGS=["version.lib"])
    else:
        env_wrap.Append(LINKFLAGS=["-Wl,--subsystem,console"])
        env_wrap.Append(LIBS=["version"])

    prog_wrap = env_wrap.add_program("#bin/godot", common_win_wrap + res_wrap_obj, PROGSUFFIX=env["PROGSUFFIX_WRAP"])
    arrange_program_clean(prog_wrap)
    env_wrap.Depends(prog_wrap, prog)
    sources += common_win_wrap + res_wrap_obj

if env["d3d12"]:
    dxc_arch_subdir = msvc_arch_aliases[env["arch"]]

    agility_target_aliases = {
        "x86_32": "win32",
        "x86_64": "x64",
        "arm32": "arm",
        "arm64": "arm64",
    }
    agility_arch_subdir = agility_target_aliases[env["arch"]]

    # Used in cases where we can have multiple archs side-by-side.
    arch_bin_dir = "#bin/" + env["arch"]

    # Agility SDK
    if env["agility_sdk_path"] != "" and os.path.exists(env["agility_sdk_path"]):
        agility_dlls = ["D3D12Core.dll", "d3d12SDKLayers.dll"]
        # Whether these are loaded from arch-specific directory or not has to be known at build time.
        target_dir = arch_bin_dir if env["agility_sdk_multiarch"] else "#bin"
        for dll in agility_dlls:
            env.Command(
                target_dir + "/" + dll,
                env["agility_sdk_path"] + "/build/native/bin/" + agility_arch_subdir + "/" + dll,
                Copy("$TARGET", "$SOURCE"),
            )

    # PIX
    if env["use_pix"]:
        pix_dll = "WinPixEventRuntime.dll"
        env.Command(
            "#bin/" + pix_dll,
            env["pix_path"] + "/bin/" + dxc_arch_subdir + "/" + pix_dll,
            Copy("$TARGET", "$SOURCE"),
        )
    
# d3d47 compiler DLL for ANGLE
if env["angle_libs"] and env["winsdk_sysroot"]:
    arch_subdir = msvc_arch_aliases[env["arch"]]
    d3dcompiler_dll = "d3dcompiler_47.dll"

    # Normalise MSYS2/Git bash paths
    sysroot = env["winsdk_sysroot"]
    if sysroot.startswith("/") and len(sysroot) > 2 and sysroot[2] == "/":
        sysroot = sysroot[1] + ":" + sysroot[2:]

    bin_dir = os.path.join(sysroot, "bin")
    sdk_version = env.get("winsdk_version", "")
    resolved_dll_path = ""
    explicit_version = ARGUMENTS.get("winsdk_version", env.get("winsdk_version", ""))

    # Use the version explicitly requested frist
    if explicit_version:
        potential_path = os.path.join(bin_dir, explicit_version, arch_subdir, d3dcompiler_dll)
        if os.path.exists(potential_path):
            resolved_dll_path = potential_path

    # Probe for the highest WinSDK folder containing the DLL
    if not resolved_dll_path and os.path.exists(bin_dir):
        try:
            subdirs = [d for d in os.listdir(bin_dir) if os.path.isdir(os.path.join(bin_dir, d))]
            # Filter for standard Windows 10/11 SDK version patterns (e.g., 10.x.x.x)
            sdk_versions = [d for d in subdirs if d.startswith("10.")]
            
            if sdk_versions:
                # Sort components semantically as integers (e.g., 10.0.22621.0 > 10.0.18362.0)
                sdk_versions.sort(key=lambda s: [int(x) for x in s.split(".") if x.isdigit()], reverse=True)
                
                for version in sdk_versions:
                    potential_path = os.path.join(bin_dir, version, arch_subdir, d3dcompiler_dll)
                    if os.path.exists(potential_path):
                        resolved_dll_path = potential_path
                        break
        except Exception:
            pass

    # Fallback to the original hardcoded path
    if not resolved_dll_path:
        sdk_version = sdk_version if sdk_version else "10.0.18362.0"
        resolved_dll_path = env["winsdk_sysroot"] + "/bin/" + sdk_version + "/" + arch_subdir + "/" + d3dcompiler_dll
    else:
        # Uniformly format slashes
        resolved_dll_path = resolved_dll_path.replace("\\", "/")

    env.Command(
        "#bin/" + d3dcompiler_dll,
        resolved_dll_path,
        Copy("$TARGET", "$SOURCE"),
    )

if env.get("msvc_redist_path") or env.get("msvc_stl_root"):
    target_arch = msvc_arch_aliases[env["arch"]]
    is_debug = bool(env["debug_crt"])
    has_custom_stl = bool(env.get("msvc_stl_root"))

    # Standard Visual C++ runtime
    if env.get("msvc_redist_path"):
        redist_path = norm_msys_path(env["msvc_redist_path"]).rstrip("/")
        explicit_ver = ARGUMENTS.get("msvc_redist_version", env.get("msvc_redist_version", ""))

        if os.path.exists(redist_path):
            # Step into version directory if at .../Redist/MSVC
            if explicit_ver and os.path.exists(f"{redist_path}/{explicit_ver}"):
                redist_path = f"{redist_path}/{explicit_ver}"
            else:
                subdirs = [d for d in os.listdir(redist_path) if os.path.isdir(f"{redist_path}/{d}")]
                versions = [d for d in subdirs if d[0].isdigit()]
                if versions:
                    versions.sort(key=lambda s: [int(x) for x in s.split(".") if x.isdigit()], reverse=True)
                    redist_path = f"{redist_path}/{versions[0]}"

            # Step into target_arch directory if at .../<version>
            if os.path.basename(redist_path).lower() != target_arch.lower():
                arch_candidate = f"{redist_path}/{target_arch}"
                if os.path.exists(arch_candidate):
                    redist_path = arch_candidate

            # Step into Microsoft.VC*.CRT if at .../<target_arch>
            if not (os.path.basename(redist_path).startswith("Microsoft.VC") and "CRT" in os.path.basename(redist_path)):
                if os.path.exists(redist_path):
                    crt_suffix = ".DebugCRT" if is_debug else ".CRT"
                    crt_dirs = [
                        d
                        for d in os.listdir(redist_path)
                        if os.path.isdir(f"{redist_path}/{d}")
                        and d.startswith("Microsoft.VC")
                        and d.endswith(crt_suffix)
                    ]
                    if not crt_dirs:
                        crt_dirs = [
                            d
                            for d in os.listdir(redist_path)
                            if os.path.isdir(f"{redist_path}/{d}")
                            and d.startswith("Microsoft.VC")
                            and d.endswith(".CRT")
                        ]
                    if crt_dirs:
                        redist_path = f"{redist_path}/{crt_dirs[0]}"

            if os.path.exists(redist_path):
                for file in os.listdir(redist_path):
                    file_lower = file.lower()
                    if not (file_lower.endswith(".dll") or file_lower.endswith(".pdb")):
                        continue

                    # Skip standard MSVCP if custom STL is being bundled
                    if has_custom_stl and file_lower.startswith("msvcp"):
                        continue

                    stem = os.path.splitext(file_lower)[0]
                    is_debug_dll = stem.endswith("d") or "_1d" in stem or "_2d" in stem
                    if is_debug != is_debug_dll:
                        continue

                    copied_node = env.Command(
                        "#bin/" + file,
                        redist_path + "/" + file,
                        Copy("$TARGET", "$SOURCE"),
                    )
                    env.Depends(prog, copied_node)

    # Custom STL DLLs from <msvc_stl_root>/bin/<target_arch>
    if has_custom_stl:
        stl_root = norm_msys_path(env["msvc_stl_root"]).rstrip("/")
        stl_bin_path = f"{stl_root}/bin/{target_arch}"
        if not os.path.exists(stl_bin_path):
            stl_bin_path = f"{stl_root}/{target_arch}" if os.path.exists(f"{stl_root}/{target_arch}") else stl_root

        if os.path.exists(stl_bin_path):
            for file in os.listdir(stl_bin_path):
                file_lower = file.lower()
                if not (file_lower.endswith(".dll") or file_lower.endswith(".pdb")):
                    continue

                stem = os.path.splitext(file_lower)[0]
                if stem.endswith("_oss"):
                    stem = stem[:-4]
                if stem.endswith("_codecvt_ids"):
                    stem = stem[:-12]

                is_debug_dll = stem.endswith("d")
                if is_debug != is_debug_dll:
                    continue

                copied_node = env.Command(
                    "#bin/" + file,
                    stl_bin_path + "/" + file,
                    Copy("$TARGET", "$SOURCE"),
                )
                env.Depends(prog, copied_node)

if not os.getenv("VCINSTALLDIR"):
    if env["debug_symbols"]:
        env.AddPostAction(prog, env.Run(platform_windows_builders.make_debug_mingw))
        if env["windows_subsystem"] == "gui":
            env.AddPostAction(prog_wrap, env.Run(platform_windows_builders.make_debug_mingw))

env.platform_sources += sources
